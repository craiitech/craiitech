
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Core Helper Functions
     */
    function isSignedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) ||
        (hasProfile() && profile().get('role', '') in ['Admin', 'admin', 'Administrator', 'administrator', 'System Administrator', 'Super Admin'])
      );
    }

    function isSupervisor() {
      return isSignedIn() && hasProfile() && (
        profile().get('role', '').matches('(?i).*(director|odimo|admin|dean of instruction|doi).*') ||
        profile().get('role', '').matches('(?i).*vice president.*') ||
        ((profile().get('unitId', '') == 'W61XJkVKga3ra2JaLINg' ||
         profile().get('unitName', '').matches('(?i).*(dean of instruction|doi).*')) &&
         !profile().get('role', '').matches('(?i).*(coordinator|faculty).*'))
      );
    }

    // --------------------------------------------------------------------------
    // FIAMO Helper Functions
    // --------------------------------------------------------------------------

    function isFiamoRole(role) {
      return isSignedIn() && hasProfile() && profile().get('fiamoRole', '') == role;
    }

    function isFiamoCoordinator() {
      return isAdmin() || isFiamoRole('Unit Coordinator');
    }

    function isFiamoStaff() {
      return isFiamoRole('FIAMO Staff');
    }

    function isFiamoOversight() {
      return isAdmin() || isFiamoRole('Unit ODIMO') || isFiamoRole('VPAF') || isSupervisor();
    }

    function hasFiamoSettings() {
      return exists(/databases/$(database)/documents/system/fiamoSettings);
    }

    function fiamoSettingsData() {
      return get(/databases/$(database)/documents/system/fiamoSettings).data;
    }

    // Main Campus FIAMO office members monitor every campus:
    // system admin, FIAMO admin, VPAF, FIAMO office unit members, and the
    // legacy top-level coordinator / ODIMO / staff assignments.
    function isMainCampusFiamoMonitor() {
      return isSignedIn() && hasProfile() && (
        isAdmin() ||
        profile().get('fiamoRole', '') == 'VPAF' ||
        (hasFiamoSettings() && (
          fiamoSettingsData().get('fiamoAdminId', '') == request.auth.uid ||
          fiamoSettingsData().get('vpafIds', []).hasAny([request.auth.uid]) ||
          fiamoSettingsData().get('coordinatorIds', []).hasAny([request.auth.uid]) ||
          fiamoSettingsData().get('odimoIds', []).hasAny([request.auth.uid]) ||
          fiamoSettingsData().get('staffIds', []).hasAny([request.auth.uid]) ||
          (fiamoSettingsData().get('officeUnitId', '') != '' &&
           profile().get('unitId', '') == fiamoSettingsData().get('officeUnitId', ''))
        ))
      );
    }

    // Personnel assigned to a specific campus via settings.campusPersonnel.
    function campusPersonnelFor(campusId) {
      return hasFiamoSettings()
        ? fiamoSettingsData().get('campusPersonnel', {}).get(campusId, {})
        : {};
    }

    function isCampusCoordinator(campusId) {
      return isSignedIn() && hasProfile() &&
        campusPersonnelFor(campusId).get('coordinatorIds', []).hasAny([request.auth.uid]);
    }

    function isCampusOdimo(campusId) {
      return isSignedIn() && hasProfile() &&
        campusPersonnelFor(campusId).get('odimoIds', []).hasAny([request.auth.uid]);
    }

    function isCampusStaff(campusId) {
      return isSignedIn() && hasProfile() &&
        campusPersonnelFor(campusId).get('staffIds', []).hasAny([request.auth.uid]);
    }

    function isCampusPersonnel(campusId) {
      return isCampusCoordinator(campusId) || isCampusOdimo(campusId) || isCampusStaff(campusId);
    }

    // Backwards-compatible scoped checks: campusPersonnel assignment OR a legacy
    // fiamoRole whose profile campus matches the request campus.
    function isScopedCoordinator(campusId) {
      return isCampusCoordinator(campusId) ||
        (isFiamoRole('Unit Coordinator') && profile().get('campusId', '') == campusId);
    }

    function isScopedOdimo(campusId) {
      return isCampusOdimo(campusId) ||
        (isFiamoRole('Unit ODIMO') && profile().get('campusId', '') == campusId);
    }

    function isScopedStaff(campusId) {
      return isCampusStaff(campusId) ||
        (isFiamoRole('FIAMO Staff') && profile().get('campusId', '') == campusId);
    }

    function isScopedPersonnel(campusId) {
      return isScopedCoordinator(campusId) || isScopedOdimo(campusId) || isScopedStaff(campusId);
    }

    // --------------------------------------------------------------------------
    // CORE WORKFLOW COLLECTIONS
    // --------------------------------------------------------------------------
    
    match /unitFormRequests/{id} {
      allow get, list, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /procedureRevisionRequests/{id} {
      allow get, list, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /unitForms/{id} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /submissions/{id} {
      allow get, list, write: if isSignedIn();
    }

    match /unitOrgStructures/{id} {
      // All authenticated users can read (for admin/supervisor review)
      allow read: if isSignedIn() && hasProfile();
      // Unit Coordinators and ODIMOs can create records for their own unit.
      // Fallback: Campus Directors and Campus ODIMOs can create for units
      // within their own campus (when a unit lacks a coordinator/ODIMO).
      allow create: if isSignedIn() && hasProfile() && (
        isAdmin() ||
        (
          profile().get('unitId', '') == request.resource.data.unitId &&
          profile().get('role', '') in ['Unit Coordinator', 'Unit ODIMO']
        ) ||
        (
          profile().get('campusId', '') == request.resource.data.campusId &&
          profile().get('role', '') in ['Campus Director', 'Campus ODIMO']
        )
      );
      // Same restriction for updates
      allow update: if isSignedIn() && hasProfile() && (
        isAdmin() ||
        (
          profile().get('unitId', '') == resource.data.unitId &&
          profile().get('role', '') in ['Unit Coordinator', 'Unit ODIMO']
        ) ||
        (
          profile().get('campusId', '') == resource.data.campusId &&
          profile().get('role', '') in ['Campus Director', 'Campus ODIMO']
        )
      );
      // Only admins can delete
      allow delete: if isAdmin();
    }

    match /pbbSubmissions/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /risks/{id} {
      allow get, list, write: if isSignedIn();
    }

    match /employeeActivities/{id} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == resource.data.userId || isSupervisor());
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    match /wfhActivities/{id} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == resource.data.userId || isSupervisor());
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // --------------------------------------------------------------------------
    // ACADEMIC & PROGRAM MONITORING
    // --------------------------------------------------------------------------

    match /academicPrograms/{id} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin() || isSupervisor();
    }

    match /programCompliances/{id} {
      allow get, list, write: if isSignedIn();
    }

    match /unitMonitoringRecords/{id} {
      allow get, list: if isSignedIn();
      allow write: if isSupervisor() || isAdmin();
    }

    // --------------------------------------------------------------------------
    // GAD & STRATEGIC HUB
    // --------------------------------------------------------------------------

    match /gadInitiatives/{id} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /gadMainstreaming/{id} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && (isAdmin() || isSupervisor() || profile().get('role', '').matches('(?i).*coordinator.*'));
      allow delete: if isAdmin();
    }

    match /gadActivities/{id} {
      allow get, list: if isSignedIn();
      // Allow authenticated users to update/delete their own records; admins have full access
      allow update: if isSignedIn();
      allow delete: if isAdmin();
      // Allow unauthenticated public create from /gad-entry with required field validation
      allow create: if isSignedIn() || (
        request.resource.data.keys().hasAll(['activityId', 'activityName', 'campusId', 'implementingUnitId', 'participants', 'year', 'deviceFingerprint']) &&
        request.resource.data.activityId is string &&
        request.resource.data.activityName is string &&
        request.resource.data.deviceFingerprint is string
      );
    }

    match /gadPlans/{id} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && (
        isAdmin() ||
        (hasProfile() && profile().get('role', '').matches('(?i).*(coordinator|director).*')) ||
        (hasProfile() && exists(/databases/$(database)/documents/system/gadSettings) &&
         profile().get('unitId', '') == get(/databases/$(database)/documents/system/gadSettings).data.get('leadershipUnitId', ''))
      );
      allow delete: if isAdmin();
    }

    match /unitPersonnelCensus/{id} {
      allow get, list, write: if isSignedIn();
    }

    // --------------------------------------------------------------------------
    // QA REPORTS, AUDITS & CARS
    // --------------------------------------------------------------------------

    match /auditPlans/{id} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /auditSchedules/{id} {
      allow get, list: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /auditFindings/{id} {
      allow get, list: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /clauseRevisits/{id} {
      allow get, list: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /correctiveActionRequests/{id} {
      allow get, list, write: if isSignedIn();
    }

    match /eqaOfiMonitoring/{id} {
      allow get, list, write: if isSignedIn();
    }

    match /managementReviews/{id} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /managementReviewOutputs/{id} {
      allow get, list, write: if isSignedIn();
    }

    match /communications/{id} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && (
        isAdmin() ||
        profile().get('role', '').matches('(?i).*(odimo|director|president|vice president|coordinator).*')
      );
      // Stamp-receive: any signed-in user can update only recipientRefNums and/or readBy.
      // Full edits require admin or an authorized role.
      allow update: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recipientRefNums', 'readBy']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recipientRefNums']) ||
        (hasProfile() && profile().get('role', '').matches('(?i).*(odimo|director|president|vice president|coordinator).*'))
      );
      allow delete: if isAdmin();
    }

    match /visitorLogs/{id} {
      allow read, write: if isSignedIn();
    }

    match /qaAdvisories/{id} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // --------------------------------------------------------------------------
    // SYSTEM COLLECTIONS
    // --------------------------------------------------------------------------
    
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }
    
    match /roles_admin/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /campuses/{id} { 
      allow read: if true; // Required for Registration dropdown
      allow write: if isAdmin(); 
    }
    
    match /units/{id} { 
      allow read: if true; // Required for Registration unit filter
      allow write: if isAdmin(); 
    }
    
    match /roles/{id} { 
      allow get, list: if true; // Required for Registration role selection
      allow write: if isAdmin(); 
    }
    
    match /cycles/{id} { allow get, list: if isSignedIn(); allow write: if isAdmin(); }
    match /isoClauses/{id} { allow get, list: if isSignedIn(); allow write: if isAdmin(); }
    match /procedureManuals/{id} { allow get, list: if isSignedIn(); allow write: if isAdmin(); }
    match /eomsPolicyManuals/{id} { allow get, list: if isSignedIn(); allow write: if isAdmin(); }

    match /system/csmSettings {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /system/gadSettings {
      allow read: if true; // Required for the public GAD Entry page (unauthenticated participants)
      allow write: if isAdmin();
    }

    match /system/{docId} {
      allow get: if isSignedIn() || docId == 'settings' || docId == 'logo'; 
      allow list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /csmDeployments/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && hasProfile() && profile().unitId == get(/databases/$(database)/documents/system/csmSettings).data.managingUnitId);
    }

    match /csmResponses/{id} {
      allow read, write: if isSignedIn();
    }

    match /campusSettings/{id} {
      allow get, list: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /unitCsmSettings/{unitId} {
      allow get, list: if isSignedIn();
      allow write: if isSignedIn() && (
        isAdmin() || 
        isSupervisor() || 
        (hasProfile() && profile().get('role', '').matches('(?i).*coordinator.*'))
      );
    }

    match /unitPersonnel/{id} {
      allow get, list: if isSignedIn();
      allow write: if isSignedIn() && (
        isAdmin() || 
        isSupervisor() || 
        (hasProfile() && profile().get('role', '').matches('(?i).*coordinator.*'))
      );
    }

    match /activityLogs/{id} {
      allow create: if isSignedIn();
      allow get, list: if isAdmin();
    }

    match /errorReports/{id} {
      allow create: if isSignedIn();
      allow get, list: if isAdmin();
    }

    match /appFeedbacks/{id} {
      allow create: if isSignedIn();
      allow get, list: if isAdmin();
    }

    match /formDownloadLogs/{id} {
      allow create: if isSignedIn();
      allow get, list: if isAdmin();
    }

    match /softwareEvaluations/{id} {
      allow create: if true; // Allow stakeholders to evaluate
      allow get, list: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Admin-specific override for Form Roster Management
    match /unitForms/{allPaths=**} {
        allow write: if isAdmin();
    }

    // --------------------------------------------------------------------------
    // UNIT ACTIVITY & ATTENDANCE SYSTEM
    // --------------------------------------------------------------------------
    match /unitActivities/{id} {
      allow read: if true; // Public read: needed by evaluation QR portal (unauthenticated mobile users)
      allow write: if isSignedIn();
    }

    // Device bindings are immutable once created — prevents unbinding another user's device.
    // Required fields enforced to prevent garbage data.
    match /attendanceDeviceBindings/{id} {
      allow create: if true
        && request.resource.data.keys().hasAll(['userId', 'deviceFingerprint', 'userName', 'boundAt'])
        && request.resource.data.userId is string
        && request.resource.data.deviceFingerprint is string;
      allow read: if true;
      allow update, delete: if false;
    }

    // Attendance logs are immutable records. Once written, they cannot be modified or deleted.
    // Field validation ensures data integrity. Status must be one of the valid states.
    match /unitActivityAttendanceLogs/{id} {
      allow read: if true;
      allow create: if true
        && request.resource.data.keys().hasAll(['activityId', 'userId', 'status', 'scannedAt', 'deviceFingerprint'])
        && request.resource.data.activityId is string
        && request.resource.data.userId is string
        && request.resource.data.deviceFingerprint is string
        && request.resource.data.status in ['ON_TIME', 'LATE', 'OUTSIDE_WINDOW', 'REJECTED']
        && request.resource.data.scannedAt is number;
      allow update, delete: if false;
    }

    // Evaluations are submitted once — no editing after submission prevents tampering.
    // Field validation ensures all required data is present.
    match /unitActivityEvaluations/{id} {
      allow create: if true
        && request.resource.data.keys().hasAny(['ratingOverall', 'activityId', 'submittedAt'])
        && request.resource.data.activityId is string
        && request.resource.data.submittedAt is number;
      allow read: if isSignedIn();
      allow update, delete: if false;
    }

    // --------------------------------------------------------------------------
    // KPI & OKR Collections
    // --------------------------------------------------------------------------

    match /kpiDefinitions/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /kpiSnapshots/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /kpiAlerts/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /okrObjectives/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.ownerId
      );
      allow delete: if isAdmin();
    }

    match /okrKeyResults/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.ownerId
      );
      allow delete: if isAdmin();
    }

    match /okrCheckIns/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --------------------------------------------------------------------------
    // FIAMO (Facilities, Infrastructure & Auxiliary Management Office)
    // --------------------------------------------------------------------------

    // Repair requests are scoped by campus: campus personnel work only their own
    // campus's requests, requesters can see their own submissions, and Main Campus
    // FIAMO monitors can see and advance anything. State transitions are guarded
    // by role + current status.
    match /repairRequests/{id} {
      allow get, list: if isSignedIn() && (
        isMainCampusFiamoMonitor() ||
        isScopedPersonnel(resource.data.campusId) ||
        request.auth.uid == resource.data.requestedBy ||
        request.auth.uid == resource.data.assignedStaffId
      );
      allow create: if isSignedIn() && (
        isMainCampusFiamoMonitor() ||
        request.resource.data.campusId == profile().get('campusId', '')
      );
      allow update: if isSignedIn() && (
        // Main Campus monitor or the request's own campus coordinator advances
        // the workflow after submission.
        (isMainCampusFiamoMonitor() || isScopedCoordinator(resource.data.campusId)) && (
          resource.data.status in ['Submitted', 'Reviewed', 'Completed'] ||
          request.resource.data.status != resource.data.status
        )
        ||
        // Campus staff can start work / submit evidence only on their own
        // assigned requests.
        (isScopedStaff(resource.data.campusId) &&
         request.auth.uid == resource.data.assignedStaffId &&
         resource.data.status in ['Assigned', 'InProgress'])
      );
      allow delete: if isAdmin();
    }

    match /fiamoEvidenceTypes/{id} {
      allow get, list: if isSignedIn();
      allow create, update: if isFiamoCoordinator();
      allow delete: if isAdmin();
    }

    match /fiamoWorkerTypes/{id} {
      allow get, list: if isSignedIn();
      allow create, update: if isFiamoCoordinator();
      allow delete: if isAdmin();
    }

    // FIAMO activity logs are immutable audit trail entries. Campus personnel can
    // read their own campus's logs; Main Campus monitors can read everything.
    match /fiamoActivityLogs/{id} {
      allow create: if isSignedIn();
      allow get, list: if isSignedIn() && (
        isMainCampusFiamoMonitor() ||
        isScopedPersonnel(resource.data.campusId) ||
        isFiamoOversight()
      );
      allow update, delete: if false;
    }

    match /system/fiamoSettings {
      allow read: if isSignedIn();
      allow write: if isFiamoCoordinator() || isMainCampusFiamoMonitor();
    }

    // Final catch-all for anything else
    match /{path=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
